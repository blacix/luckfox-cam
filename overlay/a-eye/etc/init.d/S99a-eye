#!/bin/sh

LED_TEST=/usr/bin/test-pwm-led.sh
MODULE=/oem/usr/ko/imx415.ko
PIDFILE=/var/run/a-eye-pwm-led.pid

is_running() {
	[ -f "$PIDFILE" ] || return 1
	pid=$(cat "$PIDFILE")
	[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

start() {
	if is_running; then
		echo "a-eye LED test is already running"
		return 0
	fi

	if ! grep -q '^imx415 ' /proc/modules; then
		if [ ! -f "$MODULE" ]; then
			echo "Missing kernel module: $MODULE" >&2
			return 1
		fi
		insmod "$MODULE"
	fi

	if [ ! -x "$LED_TEST" ]; then
		echo "Missing executable: $LED_TEST" >&2
		return 1
	fi

	"$LED_TEST" >/dev/null 2>&1 &
	echo "$!" > "$PIDFILE"
}

stop() {
	if is_running; then
		kill "$(cat "$PIDFILE")" 2>/dev/null || true
	fi
	rm -f "$PIDFILE"
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}" >&2
		exit 1
		;;
esac
